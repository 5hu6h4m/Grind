datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  habits        Habit[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  
  access_token       String?  
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Habit {
  id          String   @id @default(uuid())
  title       String
  category    String
  xp          Int
  color       String
  createdAt   DateTime @default(now())
  
  // Auth Relation (Optional for backward compatibility if user is not logged in)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Relations
  completions Completion[]
}

model Completion {
  id        String   @id @default(uuid())
  habitId   String
  date      DateTime @default(now()) // We will store the exact day
  
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  // Ensure a habit can only be completed once per day
  @@unique([habitId, date])
}
